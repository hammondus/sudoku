# Copy to .env beside docker-compose.yaml. .env is git-ignored.

# --- SMTP for sign-in codes (AWS SES) --------------------------------------
# HOST is the SES SMTP endpoint for your region, for example
# email-smtp.ap-southeast-2.amazonaws.com. USERNAME and PASSWORD are SES SMTP
# credentials, not IAM access keys. FROM must be a verified SES identity.
# While SES is in sandbox mode it sends only to verified addresses.
# With HOST or FROM unset, the server logs each code instead of sending it.
SUDOKU_SMTP_HOST=
SUDOKU_SMTP_PORT=587
SUDOKU_SMTP_USERNAME=
SUDOKU_SMTP_PASSWORD=
SUDOKU_SMTP_FROM=Sudoku <sudoku@example.com>
